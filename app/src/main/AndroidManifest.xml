<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cần INTERNET để gọi REST API server và stream nhạc -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- FOREGROUND_SERVICE để MusicService chạy khi app ở background -->
    <!-- TẠI SAO cần Foreground Service? → Android kill background service sau vài phút,
         nhưng music player cần chạy liên tục khi user chuyển app khác -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Android 13+ yêu cầu permission riêng để hiện notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicPlayer"
        android:usesCleartextTraffic="true">
        <!-- TẠI SAO cần usesCleartextTraffic="true"?
             → Android 9+ (API 28) MẶC ĐỊNH chặn HTTP (cleartext) vì lý do bảo mật
             → Server dev chạy trên localhost:3000 chỉ có HTTP (không HTTPS)
             → Bật cờ này để app gọi được http://10.0.2.2:3000 khi dev
             → Khi deploy lên Render (HTTPS) thì không ảnh hưởng, vẫn an toàn
             → LƯU Ý: với production nên dùng network_security_config.xml thay vì bật toàn bộ
        -->
        <!-- HomeActivity — màn hình chính MỚI, là LAUNCHER -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity — màn hình TÌM KIẾM (bản cũ, DI thủ công để so sánh).
             Không còn là launcher, được mở từ nút search trên Home. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- SongListActivity — danh sách bài hát (playlist / thể loại) -->
        <activity
            android:name=".ui.SongListActivity"
            android:exported="false" />

        <!-- MusicService — phát nhạc nền với notification -->
        <service
            android:name=".service.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- MediaButtonReceiver — nhận nút bấm vật lý từ tai nghe/Bluetooth
             (ngay cả khi app chạy nền / khóa màn hình), chuyển đến MusicService
             qua MediaSessionCompat -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
            <meta-data
                android:name="androidx.media.session.MediaButtonReceiver.serviceName"
                android:value="com.example.musicplayer.service.MusicService" />
        </receiver>
    </application>

</manifest>