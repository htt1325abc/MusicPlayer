<?xml version="1.0" encoding="utf-8"?>
<!-- Item playlist (card cuộn ngang): ảnh vuông bo góc + nút lưu bookmark + tên + số bài.
     PHẦN 3: thêm btnSave (icon bookmark) nằm GÓC TRÊN-PHẢI của ảnh bìa,
     bấm để lưu/bỏ lưu playlist vào Room (saved_playlists). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:rippleColor="@color/white"
    tools:ignore="RtlSymmetry">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Ảnh bìa playlist + nút lưu bookmark chồng lên góc (FrameLayout = lớp chồng) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="134dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPlaylistThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh playlist"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <!-- Nút lưu/bỏ lưu playlist (PHẦN 3) -->
            <ImageButton
                android:id="@+id/btnSave"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Lưu playlist"
                android:scaleType="centerInside"
                android:src="@drawable/ic_bookmark_border" />

        </FrameLayout>

        <!-- Tên playlist -->
        <TextView
            android:id="@+id/tvPlaylistTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="Top 100 Bài Hát Nhạc Trẻ Hay Nhất" />

        <!-- Số bài hát -->
        <TextView
            android:id="@+id/tvPlaylistCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="100 bài" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
